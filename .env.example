# Copy to .env next to compose.yaml. Every GAMMICH_* variable below is read by
# the server; the others only configure compose.yaml.

# Folder holding your recordings, one sub-folder per game.
GAMMICH_VIDEOS_DIR=/path/to/recordings

# Built-in login. Set it unless a reverse proxy authenticates users for you.
# Without a password and without GAMMICH_PROXY_SECRET the library is read-only.
GAMMICH_PASSWORD=

# Reverse proxies in front of gammich (comma-separated CIDRs), so login rate
# limiting uses the visitor's address from X-Forwarded-For.
# GAMMICH_TRUSTED_PROXIES=

# Host port and interface for the web UI.
GAMMICH_PORT=8080
GAMMICH_BIND=0.0.0.0

# Reverse proxy with its own login (Authelia, Authentik, oauth2-proxy): the
# proxy sends this value as the X-Gammich-Proxy-Secret header, see
# deploy/Caddyfile.example. Generate with: openssl rand -hex 32
# GAMMICH_PROXY_SECRET=

# Token for scripts/gen-previews.ps1, which builds previews on another machine
# (a GPU workstation) and uploads them. Generate with: openssl rand -hex 32
# GAMMICH_INGEST_TOKEN=

# Concurrent ffmpeg preview workers inside the container (0 disables them).
# GAMMICH_PREVIEW_WORKERS=1

# ffmpeg -hwaccel value for preview decoding (empty = CPU).
# GAMMICH_HWACCEL=
